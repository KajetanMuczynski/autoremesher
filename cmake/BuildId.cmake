#
# The build id: the one place it is worked out, for autoremesher-cli
# (--version) and the Blender add-on (addon/package.py). Script mode:
#
#   cmake -DSOURCE_DIR=<repo> [-DBUILD_ID=<id>] [-DOUTPUT_DIR=<dir>] -P cmake/BuildId.cmake
#
# The id is BUILD_ID when given and not empty, else "<short commit>[-dirty]
# <commit date>" from git, else "dev" (no git, or not a checkout). With
# OUTPUT_DIR it writes build_id.h and build-id.txt there, touching them only
# when the id changed (so only what includes the header rebuilds); without,
# it prints the id.

if(NOT BUILD_ID)
    set(BUILD_ID "dev")
    find_program(GIT_EXECUTABLE git)
    if(GIT_EXECUTABLE)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" log -1 --abbrev=7 "--format=%h %cs"
            OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE failed ERROR_QUIET)
        if(NOT failed AND commit MATCHES "^([0-9a-f]+) ([0-9-]+)$")
            set(hash "${CMAKE_MATCH_1}")
            set(date "${CMAKE_MATCH_2}")
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
                OUTPUT_VARIABLE changes RESULT_VARIABLE failed ERROR_QUIET)
            if(failed OR NOT changes STREQUAL "")
                string(APPEND hash "-dirty")
            endif()
            set(BUILD_ID "${hash} ${date}")
        endif()
    endif()
endif()
if(BUILD_ID MATCHES "[\"\\\\\n]")
    message(FATAL_ERROR "build id must not hold quotes, backslashes or newlines: ${BUILD_ID}")
endif()

if(NOT OUTPUT_DIR)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${BUILD_ID}")
    return()
endif()
# configure_file leaves a file whose content is unchanged untouched.
file(WRITE "${OUTPUT_DIR}/build_id.h.new"
    "// Generated by cmake/BuildId.cmake.\n#define AUTOREMESHER_BUILD_ID \"${BUILD_ID}\"\n")
configure_file("${OUTPUT_DIR}/build_id.h.new" "${OUTPUT_DIR}/build_id.h" COPYONLY)
file(WRITE "${OUTPUT_DIR}/build-id.txt.new" "${BUILD_ID}\n")
configure_file("${OUTPUT_DIR}/build-id.txt.new" "${OUTPUT_DIR}/build-id.txt" COPYONLY)
